# ---------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ---------------------------------------------
# For local PostgreSQL or cloud PostgreSQL (Neon, Supabase, Neon.tech, AWS RDS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/university_library?schema=public"

# Direct URL for Prisma migrations if using PgBouncer/connection pooling
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/university_library?schema=public"

# ---------------------------------------------
# CLERK AUTHENTICATION
# ---------------------------------------------
# Obtain these from your Clerk Dashboard (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key
CLERK_SECRET_KEY=sk_test_placeholder_secret

# Clerk Redirection URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ---------------------------------------------
# APP CONFIGURATION
# ---------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_LIBRARY_NAME="Apex University Library"

# Daily fine rate in USD
NEXT_PUBLIC_FINE_PER_DAY=1.00

# Default loan duration in days
DEFAULT_LOAN_DAYS=14
